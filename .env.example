# ============================================
# AI Communication Service - Environment Configuration
# ============================================

# ============================================
# Application Settings
# ============================================
APP_NAME=AI Communication Service
APP_VERSION=1.0.0
DEBUG=false

# ============================================
# API Settings
# ============================================
# Comma-separated list of valid API keys
API_KEYS=your-api-key-1,your-api-key-2

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================
# AI Model Settings
# ============================================
# Google Gemini (FREE)
GOOGLE_API_KEY=

# OpenAI (Optional)
# OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude (Optional)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Default AI model to use
DEFAULT_AI_MODEL=

# ============================================
# Memory & Session Settings
# ============================================
MAX_CONVERSATION_HISTORY=50
SESSION_TIMEOUT_MINUTES=60

# ============================================
# External Services (Optional)
# ============================================
# Zalo OA
# ZALO_ACCESS_TOKEN=your-zalo-token

# Facebook Messenger
# FACEBOOK_PAGE_ACCESS_TOKEN=your-facebook-token
# FACEBOOK_VERIFY_TOKEN=your-verify-token

# ============================================
# Internal Database API (Optional)
# ============================================
# DATABASE_API_URL=http://localhost:3000
# DATABASE_API_KEY=your-database-api-key

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
